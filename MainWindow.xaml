<Window x:Class="DiplomPrintGenerate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiplomPrintGenerate — Конструктор и пакетная печать дипломов" 
        Icon="app.ico"
        Height="850" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="#E2E8F0"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Margin="0,0,4,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderContent"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2,2,2,0"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Main Tabs -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,10" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎓" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DiplomPrintGenerate" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Конструктор шаблонов и пакетная печать дипломов" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Debug Controls & Project Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Debug tools (Hidden by default, toggle with Ctrl+Shift+D) -->
                    <Border x:Name="DebugToolsPanel" Visibility="Collapsed" Background="#0F172A" CornerRadius="5" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAutoScreenshots" Content="Скриншот кликов" IsChecked="False" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Checked="ChkAutoScreenshots_Changed" Unchecked="ChkAutoScreenshots_Changed" Margin="0,0,8,0"/>
                            <Button x:Name="BtnOpenScreenshots" Content="📸 Скриншоты" Click="BtnOpenScreenshots_Click" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" Padding="8,4" Margin="0,0,4,0"/>
                            <Button x:Name="BtnOpenLogs" Content="📝 Логи" Click="BtnOpenLogs_Click" Background="#1E293B" Foreground="#A7F3D0" BorderBrush="#059669" Padding="8,4"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnNewProject" Content="📄 Новый" Click="BtnNewProject_Click" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="BtnOpenProject" Content="📂 Открыть" Click="BtnOpenProject_Click" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="BtnSaveProject" Content="💾 Сохранить" Click="BtnSaveProject_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0,10,10" SelectionChanged="MainTabs_SelectionChanged">

            <!-- TAB 1: DESIGNER -->
            <TabItem Header="1. Конструктор шаблона">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Designer Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Workspace & Properties -->
                    </Grid.RowDefinitions>

                    <!-- Designer Toolbar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Load Blank, Template Presets, Zoom -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Load Blank & Template Presets Library -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnLoadTemplateImage" Content="🖼️ Загрузить бланк диплома (JPG / PNG / PDF)" Click="BtnLoadTemplateImage_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0" Padding="12,5"/>
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📁 Шаблон оформления:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="4,0,8,0" FontSize="12"/>
                                            <ComboBox x:Name="TemplatesSelector" Width="210" SelectionChanged="TemplatesSelector_SelectionChanged" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Content="💾 Сохранить шаблон..." ToolTip="Сохранить текущую разметку и фон как готовый шаблон в библиотеку" Click="BtnSaveAsTemplate_Click" Background="White" Foreground="#1E40AF" BorderBrush="#93C5FD" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0"/>
                                            <Button Content="🗑️" ToolTip="Удалить выбранный шаблон из библиотеки" Click="BtnDeleteSelectedTemplate_Click" Background="White" Foreground="#DC2626" BorderBrush="#FCA5A5" Padding="6,4"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Guides Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="BtnToggleGuides" Content="📐 Центр" Click="BtnToggleGuides_Click" IsChecked="False" Padding="8,5" Margin="0,0,6,0" Background="White" Foreground="#6D28D9" BorderBrush="#DDD6FE" FontWeight="SemiBold" ToolTip="Показать/скрыть центральные направляющие линии симметрии листа"/>
                                    <ToggleButton x:Name="BtnToggleCustomGuides" Content="📏 4 Направляющие" Click="BtnToggleCustomGuides_Click" IsChecked="False" Padding="8,5" Background="White" Foreground="#0284C7" BorderBrush="#BAE6FD" FontWeight="SemiBold" ToolTip="Включить 2 вертикальные и 2 горизонтальные направляющие (можно перетаскивать мышью)"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Add Fields Controls + Canvas Zoom Controls -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Add Fields Controls (Left) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Добавить поле на диплом:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                                    <Button Content="+ ФИО" Click="BtnAddField_Fio_Click" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button Content="+ Номинация" Click="BtnAddField_Nomination_Click" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button Content="+ Место" Click="BtnAddField_Place_Click" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button Content="+ Дата" Click="BtnAddField_Date_Click" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button Content="+ Свое поле..." Click="BtnAddField_Custom_Click" Margin="0,0,6,0" Padding="10,4" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                </StackPanel>

                                <!-- Canvas Zoom Controls (Right) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Масштаб:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,6,0"/>
                                    <Button Content="50%" Click="BtnZoom50_Click" Padding="6,4" Margin="0,0,3,0"/>
                                    <Button Content="75%" Click="BtnZoom75_Click" Padding="6,4" Margin="0,0,3,0"/>
                                    <Button Content="100%" Click="BtnZoom100_Click" Padding="6,4" Margin="0,0,3,0"/>
                                    <Button Content="По окну" Click="BtnZoomFit_Click" Padding="6,4"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Workspace + Properties -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="390"/>
                        </Grid.ColumnDefinitions>

                        <!-- Canvas Workspace (Left) -->
                        <Border Grid.Column="0" Background="#CBD5E1" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True">
                            <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#64748B">
                                <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                    <!-- Scalable Designer Canvas -->
                                    <Canvas x:Name="DesignerCanvas" Width="800" Height="1131" Background="White" ClipToBounds="True" MouseDown="DesignerCanvas_MouseDown">
                                        <!-- Template Image -->
                                        <Image x:Name="TemplateImageDisplay" Stretch="Fill" Width="{Binding Width, ElementName=DesignerCanvas}" Height="{Binding Height, ElementName=DesignerCanvas}"/>
                                        <!-- Field boxes will be added dynamically here -->
                                    </Canvas>

                                    <!-- Custom Guides Layer (2 Vertical + 2 Horizontal draggable lines) -->
                                    <Canvas x:Name="CustomGuidesCanvas" Width="{Binding Width, ElementName=DesignerCanvas}" Height="{Binding Height, ElementName=DesignerCanvas}" ClipToBounds="True" Visibility="Collapsed">
                                        <!-- Vertical Guide 1 (Left) -->
                                        <Canvas x:Name="GripGuideV1" Width="14" Height="{Binding Height, ElementName=DesignerCanvas}" Cursor="SizeWE" MouseLeftButtonDown="Guide_MouseLeftButtonDown" MouseMove="Guide_MouseMove" MouseLeftButtonUp="Guide_MouseLeftButtonUp" Tag="1">
                                            <Border Width="14" Height="{Binding Height, ElementName=DesignerCanvas}" Background="#01000000"/>
                                            <Line X1="7" Y1="0" X2="7" Y2="{Binding Height, ElementName=DesignerCanvas}" Stroke="#0284C7" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                        </Canvas>

                                        <!-- Vertical Guide 2 (Right) -->
                                        <Canvas x:Name="GripGuideV2" Width="14" Height="{Binding Height, ElementName=DesignerCanvas}" Cursor="SizeWE" MouseLeftButtonDown="Guide_MouseLeftButtonDown" MouseMove="Guide_MouseMove" MouseLeftButtonUp="Guide_MouseLeftButtonUp" Tag="2">
                                            <Border Width="14" Height="{Binding Height, ElementName=DesignerCanvas}" Background="#01000000"/>
                                            <Line X1="7" Y1="0" X2="7" Y2="{Binding Height, ElementName=DesignerCanvas}" Stroke="#0284C7" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                        </Canvas>

                                        <!-- Horizontal Guide 1 (Top) -->
                                        <Canvas x:Name="GripGuideH1" Width="{Binding Width, ElementName=DesignerCanvas}" Height="14" Cursor="SizeNS" MouseLeftButtonDown="Guide_MouseLeftButtonDown" MouseMove="Guide_MouseMove" MouseLeftButtonUp="Guide_MouseLeftButtonUp" Tag="3">
                                            <Border Width="{Binding Width, ElementName=DesignerCanvas}" Height="14" Background="#01000000"/>
                                            <Line X1="0" Y1="7" X2="{Binding Width, ElementName=DesignerCanvas}" Y2="7" Stroke="#0284C7" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                        </Canvas>

                                        <!-- Horizontal Guide 2 (Bottom) -->
                                        <Canvas x:Name="GripGuideH2" Width="{Binding Width, ElementName=DesignerCanvas}" Height="14" Cursor="SizeNS" MouseLeftButtonDown="Guide_MouseLeftButtonDown" MouseMove="Guide_MouseMove" MouseLeftButtonUp="Guide_MouseLeftButtonUp" Tag="4">
                                            <Border Width="{Binding Width, ElementName=DesignerCanvas}" Height="14" Background="#01000000"/>
                                            <Line X1="0" Y1="7" X2="{Binding Width, ElementName=DesignerCanvas}" Y2="7" Stroke="#0284C7" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                        </Canvas>

                                        <!-- Floating Badge when dragging a custom guide -->
                                        <Border x:Name="GuideDragBadge" Background="#0284C7" CornerRadius="4" Padding="6,2" Visibility="Collapsed" Canvas.ZIndex="100">
                                            <TextBlock x:Name="GuideDragBadgeText" Text="X: 100 px" Foreground="White" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                        </Border>
                                    </Canvas>

                                    <!-- Photoshop-style Smart Guides & Snap Overlay -->
                                    <Canvas x:Name="GuideOverlayCanvas" Width="{Binding Width, ElementName=DesignerCanvas}" Height="{Binding Height, ElementName=DesignerCanvas}" IsHitTestVisible="False" ClipToBounds="True">
                                        <!-- Permanent subtle center guides (toggleable) -->
                                        <Line x:Name="PermanentCenterGuideV" X1="400" Y1="0" X2="400" Y2="1131" Stroke="#818CF8" StrokeThickness="1" StrokeDashArray="4 4" Opacity="0.6" Visibility="Collapsed"/>
                                        <Line x:Name="PermanentCenterGuideH" X1="0" Y1="565.5" X2="800" Y2="565.5" Stroke="#818CF8" StrokeThickness="1" StrokeDashArray="4 4" Opacity="0.6" Visibility="Collapsed"/>

                                        <!-- Magnetic Snap Guides (Photoshop Magenta) -->
                                        <Line x:Name="SnapGuideLineV" X1="0" Y1="0" X2="0" Y2="1131" Stroke="#EC4899" StrokeThickness="1.5" StrokeDashArray="3 2" Visibility="Collapsed"/>
                                        <Line x:Name="SnapGuideLineH" X1="0" Y1="0" X2="800" Y2="0" Stroke="#EC4899" StrokeThickness="1.5" StrokeDashArray="3 2" Visibility="Collapsed"/>

                                        <!-- Dynamic Alignment Badges -->
                                        <Border x:Name="SnapGuideBadgeV" Background="#EC4899" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock x:Name="SnapGuideBadgeVText" Text="Центр листа" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border x:Name="SnapGuideBadgeH" Background="#EC4899" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock x:Name="SnapGuideBadgeHText" Text="Центр листа" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <!-- Properties Panel (Right) -->
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16,14,10,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Placeholder when no field is selected -->
                                <StackPanel x:Name="NoSelectionPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Visibility="Collapsed">
                                    <TextBlock Text="👆" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Поле не выбрано" FontWeight="Bold" FontSize="16" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Кликните по любому полю на дипломе слева или создайте новое поле кнопками на панели сверху." TextWrapping="Wrap" TextAlignment="Center" Foreground="#64748B" FontSize="12" LineHeight="18"/>
                                </StackPanel>

                                <!-- Active Field Properties Form -->
                                <ScrollViewer x:Name="PropertiesScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PropertiesPanel" Visibility="Visible" Margin="0,0,12,0">
                                        <TextBlock Text="Параметры выбранного поля" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                                        <TextBlock Text="Название поля (колонка):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" FontSize="12"/>
                                        <TextBox x:Name="PropName" TextChanged="PropName_TextChanged" Margin="0,0,0,6"/>

                                        <TextBlock Text="Пример текста для предпросмотра:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" FontSize="12"/>
                                        <TextBox x:Name="PropSampleText" TextChanged="PropSampleText_TextChanged" Margin="0,0,0,6"/>

                                        <TextBlock Text="Шрифт:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" FontSize="12"/>
                                        <ComboBox x:Name="PropFontFamily" SelectionChanged="PropFontFamily_SelectionChanged" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Размер шрифта:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" FontSize="12"/>
                                            <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="4" Padding="6,2" BorderBrush="#BFDBFE" BorderThickness="1">
                                                <TextBlock x:Name="PropFontSizeText" Text="28 pt" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="PropFontSizeSlider" Minimum="10" Maximum="100" Value="28" ValueChanged="PropFontSizeSlider_ValueChanged" Margin="0,0,0,8"/>

                                        <!-- Font Styles (Row 1) -->
                                        <TextBlock Text="Начертание шрифта:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" FontSize="12"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="PropBoldToggle" Grid.Column="0" Content="Жирный (Bold)" FontWeight="Bold" Click="PropBoldToggle_Click" Margin="0,0,3,0" Padding="6,4"/>
                                            <ToggleButton x:Name="PropItalicToggle" Grid.Column="1" Content="Курсив (Italic)" FontStyle="Italic" Click="PropItalicToggle_Click" Margin="3,0,0,0" Padding="6,4"/>
                                        </Grid>

                                        <!-- Alignment (Row 2) -->
                                        <TextBlock Text="Выравнивание текста:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" FontSize="12"/>
                                        <Border Background="#F8FAFC" CornerRadius="6" Padding="4,5" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="PropAlignLeft" Grid.Column="0" Content="По левому" Checked="PropAlign_Checked" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <RadioButton x:Name="PropAlignCenter" Grid.Column="1" Content="По центру" Checked="PropAlign_Checked" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="True" FontWeight="SemiBold"/>
                                                <RadioButton x:Name="PropAlignRight" Grid.Column="2" Content="По правому" Checked="PropAlign_Checked" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Color -->
                                        <TextBlock Text="Цвет текста:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2" FontSize="12"/>
                                        <WrapPanel Margin="0,0,0,4">
                                            <Button Content="Черный" Click="SetColor_Click" Tag="#1A202C" Margin="0,0,4,4" Padding="6,3" FontSize="11"/>
                                            <Button Content="Золотой" Click="SetColor_Click" Tag="#CDA04B" Margin="0,0,4,4" Padding="6,3" FontSize="11"/>
                                            <Button Content="Синий" Click="SetColor_Click" Tag="#182B49" Margin="0,0,4,4" Padding="6,3" FontSize="11"/>
                                            <Button Content="Бордовый" Click="SetColor_Click" Tag="#7F1D1D" Margin="0,0,4,4" Padding="6,3" FontSize="11"/>
                                            <Button Content="Белый" Click="SetColor_Click" Tag="#FFFFFF" Margin="0,0,4,4" Padding="6,3" FontSize="11"/>
                                        </WrapPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PropColorHex" Text="#1A202C" TextChanged="PropColorHex_TextChanged" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" ToolTip="HEX-код цвета (например #182B49)"/>
                                            <Border x:Name="PropColorPreview" Grid.Column="1" Background="#1A202C" CornerRadius="4" Margin="6,0,0,0" Height="28" BorderBrush="#94A3B8" BorderThickness="1.5" Cursor="Hand" MouseDown="PropColorPreview_MouseDown" ToolTip="Пипетка: нажмите, чтобы взять цвет с любого места диплома или экрана">
                                                <Grid>
                                                    <Border Background="#44000000" CornerRadius="3" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Auto-shrink -->
                                        <CheckBox x:Name="PropAutoShrink" Content="Автоматически уменьшать длинный текст" IsChecked="True" Checked="PropAutoShrink_Changed" Unchecked="PropAutoShrink_Changed" Margin="0,0,0,8" FontWeight="SemiBold"/>

                                        <!-- Position & Movement Controls -->
                                        <TextBlock Text="Положение и выравнивание:" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,3" FontSize="12"/>
                                        <Border Background="#F8FAFC" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <StackPanel>
                                                <!-- Live Coordinates & Step Selector -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="X:" FontWeight="Bold" Foreground="#64748B" FontSize="11" Margin="0,0,3,0"/>
                                                        <TextBlock x:Name="PropPosXText" Text="100 px" FontWeight="SemiBold" Foreground="#0F172A" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Y:" FontWeight="Bold" Foreground="#64748B" FontSize="11" Margin="0,0,3,0"/>
                                                        <TextBlock x:Name="PropPosYText" Text="280 px" FontWeight="SemiBold" Foreground="#0F172A" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Шаг:" VerticalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="0,0,3,0"/>
                                                        <ComboBox x:Name="NudgeStepSelector" SelectedIndex="2" Width="62" VerticalAlignment="Center" FontSize="11">
                                                            <ComboBoxItem Content="1 px"/>
                                                            <ComboBoxItem Content="5 px"/>
                                                            <ComboBoxItem Content="10 px"/>
                                                            <ComboBoxItem Content="25 px"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Directional Movement Buttons -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="⬅ Влево" Click="BtnNudgeLeft_Click" Margin="0,0,2,0" Padding="3,5" FontSize="11" ToolTip="Сдвинуть влево (стрелка ← на клавиатуре)"/>
                                                    <Button Grid.Column="1" Content="⬆ Вверх" Click="BtnNudgeUp_Click" Margin="2,0,2,0" Padding="3,5" FontSize="11" ToolTip="Сдвинуть вверх (стрелка ↑ на клавиатуре)"/>
                                                    <Button Grid.Column="2" Content="⬇ Вниз" Click="BtnNudgeDown_Click" Margin="2,0,2,0" Padding="3,5" FontSize="11" ToolTip="Сдвинуть вниз (стрелка ↓ на клавиатуре)"/>
                                                    <Button Grid.Column="3" Content="➡ Вправо" Click="BtnNudgeRight_Click" Margin="2,0,0,0" Padding="3,5" FontSize="11" ToolTip="Сдвинуть вправо (стрелка → на клавиатуре)"/>
                                                </Grid>

                                                <!-- Center Horizontally Button -->
                                                <Button Content="📐 Разместить ровно по центру листа" Click="BtnCenterHorizontally_Click" Padding="6,5" FontWeight="SemiBold" Background="White" Foreground="#1D4ED8" BorderBrush="#BFDBFE" ToolTip="Выровнять блок строго по горизонтальному центру диплома"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📋 Дублировать" Click="BtnDuplicateField_Click" Margin="0,0,3,0" Padding="6,5"/>
                                            <Button Grid.Column="1" Content="🗑️ Удалить поле" Click="BtnDeleteField_Click" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" Margin="3,0,0,0" Padding="6,5"/>
                                        </Grid>

                                        <!-- Custom Guides Panel (Visible when 4 Guides toggled on) -->
                                        <Border x:Name="CustomGuidesSettingsCard" Visibility="Collapsed" Background="#F0F9FF" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="#BAE6FD" BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="📏 Направляющие полей (4 линии):" FontWeight="Bold" Foreground="#0369A1" FontSize="11" VerticalAlignment="Center"/>
                                                    <Button Content="🎯 Поля 10%" Click="BtnResetGuides_Click" Padding="6,2" FontSize="10" Background="White" Foreground="#0284C7" BorderBrush="#BAE6FD" ToolTip="Сбросить направляющие на стандартные отступы 10% от краев"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Левая:" Foreground="#475569" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBox x:Name="TxtGuideV1" Text="80" Width="44" Padding="2" FontSize="11" LostFocus="TxtGuide_LostFocus" KeyDown="TxtGuide_KeyDown"/>
                                                        <TextBlock Text="px" Foreground="#94A3B8" FontSize="10" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Правая:" Foreground="#475569" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBox x:Name="TxtGuideV2" Text="720" Width="44" Padding="2" FontSize="11" LostFocus="TxtGuide_LostFocus" KeyDown="TxtGuide_KeyDown"/>
                                                        <TextBlock Text="px" Foreground="#94A3B8" FontSize="10" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Верх:" Foreground="#475569" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBox x:Name="TxtGuideH1" Text="120" Width="44" Padding="2" FontSize="11" LostFocus="TxtGuide_LostFocus" KeyDown="TxtGuide_KeyDown"/>
                                                        <TextBlock Text="px" Foreground="#94A3B8" FontSize="10" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Низ:" Foreground="#475569" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBox x:Name="TxtGuideH2" Text="1010" Width="44" Padding="2" FontSize="11" LostFocus="TxtGuide_LostFocus" KeyDown="TxtGuide_KeyDown"/>
                                                        <TextBlock Text="px" Foreground="#94A3B8" FontSize="10" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,2,0,0" Padding="8,6" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="💡 Советы по позиционированию:" FontWeight="SemiBold" Foreground="#334155" FontSize="11" Margin="0,0,0,2"/>
                                                <TextBlock Text="• Перемещайте мышью: блок автоматически прилипает к центру листа (розовые направляющие, как в Photoshop)." TextWrapping="Wrap" Foreground="#64748B" FontSize="10.5" Margin="0,0,0,2"/>
                                                <TextBlock Text="• Двигайте блок стрелками клавиатуры (↑ ↓ ← →), с зажатым Shift — в 5 раз быстрее." TextWrapping="Wrap" Foreground="#64748B" FontSize="10.5"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: PARTICIPANTS TABLE -->
            <TabItem Header="2. Список участников">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Table Toolbar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Footer / Summary -->
                    </Grid.RowDefinitions>

                    <!-- Table Toolbar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➕ Добавить строку" Click="BtnAddRow_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="🗑️ Удалить выбранную" Click="BtnDeleteRow_Click" Margin="0,0,8,0"/>
                                <Button Content="📋 Вставить из Excel (Ctrl+V)" Click="BtnPasteFromExcel_Click" Margin="0,0,8,0"/>
                                <Button Content="📥 Импорт CSV / Excel" Click="BtnImportCsv_Click" Margin="0,0,8,0"/>
                                <Button Content="📤 Экспорт в CSV" Click="BtnExportCsv_Click" Margin="0,0,8,0"/>
                                <Button Content="🧹 Очистить всё" Click="BtnClearTable_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="ParticipantsCountText" Grid.Column="2" Text="Всего участников: 0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid x:Name="ParticipantsGrid" SelectionMode="Single" CanUserAddRows="True" CanUserDeleteRows="True"/>
                    </Border>

                    <!-- Footer Tip -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBlock Text="💡 Колонки таблицы автоматически соответствуют созданным полям в конструкторе. Вы можете копировать строки прямо из Excel (Ctrl+C) и вставлять сюда кнопкой «Вставить из Excel»." Foreground="#64748B" FontSize="12"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: GENERATION & PRINTING -->
            <TabItem Header="3. Генерация и печать">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Live Preview -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Navigator -->
                                <RowDefinition Height="*"/>    <!-- Preview Image -->
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnPrevParticipant" Grid.Column="0" Content="◀ Предыдущий" Click="BtnPrevParticipant_Click"/>
                                    <TextBlock x:Name="PreviewParticipantInfo" Grid.Column="1" Text="Предпросмотр: Участник 1 из N" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E293B"/>
                                    <Button x:Name="BtnNextParticipant" Grid.Column="2" Content="Следующий ▶" Click="BtnNextParticipant_Click"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#334155" CornerRadius="6" ClipToBounds="True">
                                <Grid Margin="14">
                                    <Image x:Name="LivePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Generation Settings & Action -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Параметры генерации" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                                <!-- Output Folder -->
                                <TextBlock Text="Папка для сохранения:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputFolderTextBox" IsReadOnly="True" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="Обзор..." Click="BtnBrowseOutputFolder_Click"/>
                                </Grid>

                                <!-- File Name Pattern -->
                                <TextBlock Text="Шаблон имени файла:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="FileNamePatternTextBox" Text="Диплом_{ФИО}" Margin="0,0,0,6"/>
                                <TextBlock Text="Используйте {ИмяПоля} для подстановки данных в название файла" Foreground="#64748B" FontSize="11" Margin="0,0,0,16"/>

                                <!-- Output Format -->
                                <TextBlock Text="Формат вывода:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                <StackPanel Margin="0,0,0,20">
                                    <RadioButton x:Name="RadioMultiPagePdf" Content="Единый многостраничный PDF (для печати всех сразу)" IsChecked="True" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                    <RadioButton x:Name="RadioSinglePdfs" Content="Отдельные PDF файлы для каждого участника" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioImagesPng" Content="Отдельные изображения PNG (300 DPI, типографское качество)" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioDirectPrint" Content="Прямая печать на принтер (отправить все в очередь)" Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- Big Action Button -->
                                <Button x:Name="BtnGenerateAll" Content="🚀 СГЕНЕРИРОВАТЬ ДИПЛОМЫ" Click="BtnGenerateAll_Click" Style="{StaticResource SuccessButtonStyle}" Height="48" Margin="0,0,0,12"/>

                                <!-- Progress & Status -->
                                <ProgressBar x:Name="GenerationProgressBar" Height="8" Margin="0,0,0,8" Visibility="Collapsed"/>
                                <TextBlock x:Name="GenerationStatusText" Text="" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <Button x:Name="BtnOpenOutputFolder" Content="📂 Открыть папку с результатами" Click="BtnOpenOutputFolder_Click" Visibility="Collapsed" Margin="0,0,0,16"/>

                                <Border Padding="12" Background="#F1F5F9" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Печать в высоком разрешении" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                        <TextBlock Text="Все дипломы генерируются в исходном разрешении вашего шаблона без потери четкости шрифтов." TextWrapping="Wrap" Foreground="#475569" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Live Eyedropper Floating Loupe / Info Popup -->
        <Popup x:Name="EyedropperPopup" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=RootGrid}" StaysOpen="True" IsHitTestVisible="False">
            <Border Background="#1E293B" CornerRadius="8" Padding="10,8" BorderBrush="#38BDF8" BorderThickness="2" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.5" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="EyedropperSwatch" Width="36" Height="36" CornerRadius="5" BorderBrush="White" BorderThickness="2" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EyedropperHexText" Text="#FFFFFF" FontWeight="Bold" Foreground="White" FontSize="15" FontFamily="Consolas"/>
                        <TextBlock x:Name="EyedropperRgbText" Text="RGB: 255, 255, 255" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas"/>
                        <TextBlock Text="Клик — выбрать | Esc — отмена" Foreground="#38BDF8" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
