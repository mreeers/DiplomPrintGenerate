<Window x:Class="DiplomPrintGenerate.Views.SaveTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сохранение шаблона" 
        Height="210" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Введите название для сохранения шаблона:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10" FontSize="13"/>

            <TextBox x:Name="TxtTemplateName" Grid.Row="1" Text="Мой шаблон диплома" Margin="0,0,0,20" Padding="8,6" FontSize="14"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="BtnCancel_Click" Margin="0,0,8,0" Padding="14,7"/>
                <Button Content="Сохранить шаблон" Click="BtnSave_Click" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Padding="16,7"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
